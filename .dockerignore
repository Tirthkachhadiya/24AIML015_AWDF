# ─── Frontend .dockerignore ──────────────────────────────────────────────────
# Practical 11 Supplementary: Exclude files from Docker build context
#
# node_modules — excluded to prevent host node_modules from overwriting
#                the container's freshly installed ones via COPY . .
#                Also prevents platform-specific binaries from crossing OS lines.
# dist         — excluded because Stage 2 gets it from Stage 1 (--from=builder),
#                not from the host filesystem.
# .env         — excluded; environment variables are injected at runtime.
# .git         — unnecessary inside the container.

node_modules
dist
.env
.git
*.log
npm-debug.log*
.eslintcache
